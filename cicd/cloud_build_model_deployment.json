
{
  "steps": [
    {
      "name": "gcr.io/google.com/cloudsdktool/cloud-sdk",
      "entrypoint": "gcloud",
      "args": [
        "storage",
        "cp",
        "gs://${_MODEL_REPO}/model.pkl",
        "./models/model.pkl"
      ]
    },
    {
      "name": "python:3.11.9",
      "entrypoint": "/bin/sh",
      "args": [
        "-c",
        "cd ./prediction-api && python -m pip install -r requirements.txt && python -m pytest --junitxml=/workspace/test_log.xml ./tests"
      ]
    },
    {
      "name": "gcr.io/cloud-builders/docker",
      "args": [
        "build",
        "-f",
        "prediction-api/Dockerfile",
        "-t",
        "${_LOCATION}-docker.pkg.dev/$PROJECT_ID/${_REPOSITORY}/prediction-api:0.0.1",
        "."
      ]
    },
    {
      "name": "gcr.io/cloud-builders/docker",
      "args": [
        "push",
        "${_LOCATION}-docker.pkg.dev/$PROJECT_ID/${_REPOSITORY}/prediction-api:0.0.1"
      ]
    },
    {
      "name": "gcr.io/cloud-builders/docker",
      "args": [
        "build",
        "-t",
        "${_LOCATION}-docker.pkg.dev/$PROJECT_ID/${_REPOSITORY}/prediction-ui:0.0.1",
        "./prediction-ui"
      ]
    },
    {
      "name": "gcr.io/cloud-builders/docker",
      "args": [
        "push",
        "${_LOCATION}-docker.pkg.dev/$PROJECT_ID/${_REPOSITORY}/prediction-ui:0.0.1"
      ]
    },
    {
      "name": "gcr.io/google.com/cloudsdktool/cloud-sdk",
      "entrypoint": "gcloud",
      "args": [
        "run",
        "deploy",
        "prediction-api",
        "--image",
        "${_LOCATION}-docker.pkg.dev/$PROJECT_ID/${_REPOSITORY}/prediction-api:0.0.1",
        "--region",
        "${_LOCATION}",
        "--platform",
        "managed",
        "--port",
        "5000",
        "--cpu",
        "2",
        "--memory",
        "4G",
        "--allow-unauthenticated"
      ],
      "id": "prediction-api-deploy"
    },
    {
      "name": "gcr.io/google.com/cloudsdktool/cloud-sdk",
      "entrypoint": "/bin/sh",
      "args": [
        "-c",
        "gcloud run services describe prediction-api --region ${_LOCATION} --format='value(status.url)' > /workspace/api_url.text"
      ],
      "waitFor": [
        "prediction-api-deploy"
      ],
      "id": "api-url-extraction"
    },
    {
      "name": "gcr.io/google.com/cloudsdktool/cloud-sdk",
      "entrypoint": "/bin/sh",
      "args": [
        "-c",
        "gcloud run deploy prediction-ui --image ${_LOCATION}-docker.pkg.dev/${PROJECT_ID}/${_REPOSITORY}/prediction-ui:0.0.1 --set-env-vars PREDICTOR_API=$(cat /workspace/api_url.text)/winrate_predictor --region ${_LOCATION} --platform managed --port 5000 --cpu 2 --memory 4G --allow-unauthenticated"
      ],
      "waitFor": [
        "api-url-extraction"
      ]
    }
  ],
  "artifacts": {
    "objects": {
      "location": "gs://${_TEMP_REPO}/",
      "paths": [
        "/workspace/api_url.text",
        "/workspace/test_log.xml"
      ]
    }
  },
  "options": {
    "logging": "CLOUD_LOGGING_ONLY"
  }
}
